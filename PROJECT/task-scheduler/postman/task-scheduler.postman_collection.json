        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"SEND_EMAIL\",\n  \"priority\": \"LOW\",\n  \"cron\": \"0/10 * * * * *\",\n  \"payload\": {\n    \"to\": \"report@example.com\"\n  }\n}"
        }
      }
    },
