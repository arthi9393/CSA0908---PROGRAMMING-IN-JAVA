    {
      "name": "Submit immediate job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/jobs",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "jobs"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"SEND_EMAIL\",\n  \"priority\": \"HIGH\",\n  \"payload\": {\n    \"to\": \"user@example.com\",\n    \"subject\": \"Hello\"\n  }\n}"
        }
      }
    },
